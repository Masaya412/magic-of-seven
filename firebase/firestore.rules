rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function room(code) {
      return get(/databases/$(database)/documents/rooms/$(code));
    }

    function roomAfter(code) {
      return getAfter(/databases/$(database)/documents/rooms/$(code));
    }

    function isHost(code) {
      return signedIn() && room(code).data.hostUid == request.auth.uid;
    }

    function isMember(code) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(code)/players/$(request.auth.uid));
    }

    match /rooms/{code} {
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      // 合言葉参加のため、認証済みユーザーは部屋メタ情報を読める。
      allow read: if signedIn();
      allow update, delete: if isHost(code);

      match /players/{uid} {
        allow read: if signedIn();
        // 部屋作成とホストplayer作成は同一transactionなので getAfter() を使う。
        allow create: if signedIn()
          && request.auth.uid == uid
          && roomAfter(code).data.status == "waiting";
        allow update: if signedIn()
          && request.auth.uid == uid
          && room(code).data.status == "waiting";
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(code));
      }

      match /seats/{seatId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && roomAfter(code).data.status == "waiting";
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isHost(code));
        allow update: if false;
      }

      match /system/public {
        allow read: if isMember(code);
        allow write: if isHost(code);
      }

      match /system/state {
        allow read, write: if isHost(code);
      }

      match /private/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isHost(code));
        allow write: if isHost(code);
      }

      match /actions/{actionId} {
        allow create: if isMember(code)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.processed == false;
        allow read, update, delete: if isHost(code);
      }

      // v20: ドラフト専用の軽量経路。各参加者は自分のUID documentだけ書ける。
      // 読み取り・削除はホストだけに限定し、他参加者の選択カードは見えない。
      match /draftPicks/{uid} {
        allow create, update: if isMember(code)
          && request.auth.uid == uid
          && request.resource.data.actorUid == request.auth.uid;
        allow read, delete: if isHost(code);
      }

      match /previews/{uid} {
        allow read: if isMember(code);
        allow create, update: if isMember(code)
          && request.auth.uid == uid
          && request.resource.data.actorUid == request.auth.uid;
        allow delete: if isMember(code) && request.auth.uid == uid;
      }
    }
  }
}
